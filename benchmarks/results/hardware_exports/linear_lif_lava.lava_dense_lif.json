{
  "format": "spiker.lava_dense_lif_spec.v0",
  "input_size": 8,
  "lava_lif_params": {
    "bias_exp": 0,
    "bias_mant": [
      67,
      28,
      -104,
      -77,
      125,
      90,
      -58,
      -34,
      -127,
      -2,
      -100,
      -103
    ],
    "du": 1.0,
    "dv": 0.05,
    "shape": [
      12
    ],
    "vth": 1.0
  },
  "metadata": {
    "adapter": "lava",
    "example": "export_hardware_bundle"
  },
  "neuron": {
    "decay": 0.95,
    "reset": 0.0,
    "tau_mem": 20.0,
    "threshold": 1.0
  },
  "notes": [
    "Adapter spec only; executable Lava processes are not constructed unless Lava is installed.",
    "Dense weights and optional bias are in the referenced quantized export.",
    "The mapping uses Lava LIF du=1.0 so current does not carry state between timesteps.",
    "The mapping uses dv=1/tau_mem to match spiker's membrane decay convention.",
    "Stock Lava LIF resets voltage to zero, so exact export requires reset == 0.0."
  ],
  "output_size": 12,
  "ports": {
    "dense_input": "Dense.s_in",
    "dense_output": "Dense.a_out",
    "lif_input": "LIF.a_in",
    "lif_output": "LIF.s_out"
  },
  "process": {
    "dense_class": "lava.proc.dense.process.Dense",
    "lif_class": "lava.proc.lif.process.LIF",
    "run_config_hint": "Loihi2SimCfg or Loihi2HwCfg when available; CPU simulation otherwise."
  },
  "quantization": {
    "bias_scale": 7.500772283771845e-05,
    "num_bits": 8,
    "qmax": 127,
    "qmin": -127,
    "scheme": "signed_symmetric_per_tensor",
    "weight_scale": 0.0007854551076889038
  },
  "quantized_export_path": "linear_lif_lava.dense_lif_quantized.json",
  "source_format": "spiker.dense_lif_quantized.v0",
  "target": "lava",
  "timestep_us": 1000.0,
  "weight_bits": 8
}
